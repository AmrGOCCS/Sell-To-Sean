# Where the lead form POSTs its JSON payload.
# Options:
#   - A Zapier/Make webhook URL (fastest to set up — see README)
#   - /api/lead              (Vercel serverless function in this repo)
#   - /.netlify/functions/lead  (Netlify function in this repo)
# Leave unset during development: the form logs the payload and continues.
PUBLIC_LEAD_WEBHOOK_URL=

# Used by the serverless functions (server-side only — never PUBLIC_):
CRM_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TEAM_PHONE=
