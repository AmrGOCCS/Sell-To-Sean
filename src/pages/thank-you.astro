---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.js';

const title = 'Got It — Here\'s What Happens Next | Sell to Sean';
const description = 'Your request is in. Here\'s exactly what happens in the next 24 hours.';
---

<BaseLayout title={title} description={description} noStickyCta={true} noindex={true}>
  <section class="py-14 sm:py-20">
    <div class="container-site max-w-2xl">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-100" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-700)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
      <h1 class="mt-6" style="font-size: var(--text-display)">Done. Your house is on Sean's desk.</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-700">
        Good decision — and remember, it commits you to nothing. Here's exactly what happens now:
      </p>

      <ol class="mt-8 space-y-5">
        <li class="card flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-700 font-bold text-white" aria-hidden="true">1</span>
          <div>
            <h2 class="text-lg">Within {SITE.callbackPromise}: a real person calls you</h2>
            <p class="mt-1 text-slate-600">Sean or a team member — Liam, Noah, or Marie — will call from a Columbus number to hear about the house and your situation. Keep your phone nearby.</p>
          </div>
        </li>
        <li class="card flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-700 font-bold text-white" aria-hidden="true">2</span>
          <div>
            <h2 class="text-lg">Usually within 24 hours: your written offer</h2>
            <p class="mt-1 text-slate-600">After a quick walkthrough (photos work if you're far away), you get a real number in writing — and the math behind it, explained.</p>
          </div>
        </li>
        <li class="card flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-700 font-bold text-white" aria-hidden="true">3</span>
          <div>
            <h2 class="text-lg">Then: you decide. That's it.</h2>
            <p class="mt-1 text-slate-600">Sleep on it. Show your family or attorney. Say no. The offer is free either way.</p>
          </div>
        </li>
      </ol>

      <div class="card mt-8 !bg-ice">
        <h2 class="text-lg">Want to skip the wait?</h2>
        <p class="mt-1 text-slate-600">
          Call now and you might have your first conversation in the next five minutes:
          <a href={SITE.phoneHref} class="font-bold text-brand-800 underline" data-track="phone_click" data-loc="thank_you">{SITE.phone}</a>
        </p>
        <p class="mt-3 text-sm text-slate-500">
          Helpful while you wait: jot down anything you know about the roof's age, the furnace,
          and roughly what you still owe on the house. It makes the first call faster.
        </p>
      </div>

      <p class="mt-8">
        <a href="/how-it-works/" class="font-semibold text-brand-700 underline">Meanwhile, see exactly how the rest of the process works →</a>
      </p>
    </div>
  </section>

  <script is:inline>
    window.dataLayer.push({ event: 'lead_thank_you_view' });
  </script>
</BaseLayout>
