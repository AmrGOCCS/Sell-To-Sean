---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroForm from '../components/HeroForm.astro';
import HowItWorksSteps from '../components/HowItWorksSteps.astro';
import OfferMath from '../components/OfferMath.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import TestimonialCards from '../components/TestimonialCards.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import ReviewMarquee from '../components/ReviewMarquee.astro';
import LoudBand from '../components/LoudBand.astro';
import { SITE } from '../data/site.js';
import { FEATURED_REVIEWS } from '../data/reviews.js';
import { faqsFor } from '../data/faqs.js';
import { SITUATIONS } from '../data/situations.js';
import { CITIES } from '../data/cities.js';

const title = 'Sell Your House Fast in Columbus, OH — Cash Offer in 24 Hours | Sell to Sean';
const description =
  'Get a fair, written cash offer on your Columbus house in 24 hours. No fees, no repairs, no obligation. Local buyer since 2018 — close in as little as 7 days.';
const homeFaqs = faqsFor('home').slice(0, 6);
---

<BaseLayout title={title} description={description}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-stone-200">
    <!-- Decorative depth: gradient blobs + subtle dot grid (CSS only, no requests) -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-stone-warm via-cream to-cream">
      <div class="blob -top-24 -left-24 h-96 w-96 bg-pine-200"></div>
      <div class="blob top-1/3 -right-32 h-[28rem] w-[28rem] bg-clay-100"></div>
      <div
        class="absolute inset-0 opacity-[0.35]"
        style="background-image: radial-gradient(rgba(20,60,47,0.14) 1px, transparent 1px); background-size: 26px 26px;"
      >
      </div>
    </div>

    <div class="container-site grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-20">
      <div>
        <span class="eyebrow-pill !normal-case !tracking-normal">
          <img src="/images/sean-profile-pic-2026.webp" alt="" width="24" height="24" class="-ml-1 h-6 w-6 rounded-full object-cover" />
          Hi, I'm Sean 👋 — Columbus' favorite homebuyer since {SITE.founded}
        </span>
        <h1 style="font-size: var(--text-display)" class="leading-[1.08]">
          Sell your house the <span class="hl">easy way</span> — cash offer in 24 hours.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-stone-700">
          No fees. No repairs. No strangers wandering through your living room. Tell us about
          the house and Sean brings you a fair, <strong>written</strong> cash offer — usually by
          tomorrow.
        </p>

        <!-- THE conversion element: 3 fields, one big button, zero handoff -->
        <div class="mt-7 max-w-xl rounded-3xl border-2 border-pine-100 bg-white/90 p-5 shadow-xl backdrop-blur-sm sm:p-6">
          <p class="mb-1 font-display text-xl font-bold text-pine-950">Get your free cash offer 👇</p>
          <p class="mb-4 text-sm text-stone-600">Takes 2 minutes. No obligation — just a real number.</p>
          <HeroForm />
        </div>

        <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-semibold text-stone-600">
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-pine-600">✓</span> {SITE.bbb} <span class="text-xs font-normal text-stone-400">[verify]</span></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-pine-600">✓</span> Locally owned &amp; operated</li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-pine-600">✓</span> Buying in Columbus since {SITE.founded}</li>
        </ul>
      </div>

      <figure class="relative mx-auto w-full max-w-sm lg:max-w-none">
        <!-- Offset frame behind the photo -->
        <div aria-hidden="true" class="absolute -top-4 -right-4 h-full w-full rounded-3xl bg-pine-800/90 lg:-top-5 lg:-right-5"></div>
        <!-- LCP element: explicit dimensions, no CLS -->
        <img
          src="/images/sean-profile-pic-2026.webp"
          alt="Sean Grabow, founder of Sell to Sean, smiling in downtown Columbus, Ohio"
          width="450"
          height="450"
          fetchpriority="high"
          class="relative aspect-square w-full rounded-3xl border border-stone-200 object-cover shadow-xl"
        />
        <!-- Floating proof chips (decorative motion, reduced-motion safe) -->
        <div class="animate-float absolute -left-4 top-8 hidden items-center gap-2 rounded-xl border border-stone-200 bg-white/95 px-3.5 py-2.5 shadow-lg sm:flex lg:-left-8">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-pine-100 text-pine-700" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span class="text-sm font-bold text-pine-950">$0 in fees.<span class="block text-xs font-medium text-stone-500">Ever. That's the deal.</span></span>
        </div>
        <div class="animate-float-slow absolute -bottom-5 right-2 hidden items-center gap-2 rounded-xl border border-stone-200 bg-white/95 px-3.5 py-2.5 shadow-lg sm:flex lg:-right-6">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-clay-100 text-clay-600" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </span>
          <span class="text-sm font-bold text-pine-950">Written offer in 24h<span class="block text-xs font-medium text-stone-500">Close in as little as 7 days</span></span>
        </div>
        <figcaption class="mt-6 text-center text-sm text-stone-600">
          <strong class="text-pine-900">Sean Grabow</strong> — Columbus native, founder of Sell to Sean
        </figcaption>
      </figure>
    </div>

    <!-- Real-review marquee bridges hero → page -->
    <div class="container-site pb-8">
      <ReviewMarquee />
    </div>
  </section>

  <!-- STAT BAND: the four claims that close deals, big and bold -->
  <section class="border-b border-stone-200 bg-white" aria-label="Key facts">
    <div class="container-site grid grid-cols-2 gap-x-4 gap-y-8 py-10 text-center md:grid-cols-4">
      {
        [
          ['$0', 'fees or commissions — the offer is what you get'],
          ['24 hrs', 'to a written cash offer, usually'],
          ['7 days', 'fastest closing — or pick your date'],
          ['2018', 'buying Columbus houses since'],
        ].map(([stat, label], i) => (
          <div class="reveal" style={`--reveal-delay:${i * 90}ms`}>
            <p class="font-display text-4xl font-bold text-pine-800 sm:text-5xl">{stat}</p>
            <p class="mx-auto mt-2 max-w-[16ch] text-sm leading-snug text-stone-600">{label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ANY SITUATION -->
  <section class="py-14 sm:py-20" aria-labelledby="situations-heading">
    <div class="container-site">
      <div class="reveal max-w-2xl">
        <span class="eyebrow">Any condition, any situation</span>
        <h2 id="situations-heading" style="font-size: var(--text-h2)">Whatever brought you here, we've helped someone through it.</h2>
        <p class="mt-3 leading-relaxed text-stone-700">
          Most people don't sell to a cash buyer because everything is going great. Behind on
          payments, a house you inherited, tenants you're done with — there's a page for your
          situation, with straight answers and a story from someone who's been there.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          SITUATIONS.map((s, i) => (
            <a href={`/we-buy-houses/${s.slug}/`} class="card card-lift reveal group hover:border-pine-400" style={`--reveal-delay:${i * 100}ms`}>
              <h3 class="text-lg transition-colors group-hover:text-pine-700">{s.h1}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{s.metaDescription}</p>
              <span class="mt-3 inline-flex items-center gap-1 font-semibold text-pine-700">
                Read more <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-stone-warm py-14 sm:py-20" aria-labelledby="hiw-heading">
    <div class="container-site">
      <div class="reveal mb-10 max-w-2xl">
        <span class="eyebrow">Sell in three easy steps</span>
        <h2 id="hiw-heading" style="font-size: var(--text-h2)">From "what's it worth?" to <span class="hl">money in your account</span>.</h2>
      </div>
      <HowItWorksSteps />
      <p class="mt-8">
        <a href="/how-it-works/" class="font-semibold text-pine-700 underline">See the whole process, step by step →</a>
      </p>
    </div>
  </section>

  <LoudBand />

  <!-- OFFER MATH -->
  <section class="py-14 sm:py-20" aria-labelledby="math-heading">
    <div class="container-site">
      <OfferMath />
    </div>
  </section>

  <!-- SEAN STORY -->
  <section class="bg-pine-50 py-14 sm:py-20" aria-labelledby="sean-heading">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal relative mx-auto w-full max-w-xs lg:max-w-sm">
        <div aria-hidden="true" class="absolute -bottom-4 -left-4 h-full w-full rounded-3xl border-2 border-dashed border-pine-300"></div>
        <img
          src="/images/sean-in-a-house-he-bought-sq.webp"
          alt="Sean inside a Columbus house he bought"
          width="450"
          height="450"
          loading="lazy"
          class="relative w-full rounded-3xl border border-stone-200 shadow-md"
        />
      </div>
      <div class="reveal" style="--reveal-delay:120ms">
        <span class="eyebrow">A person, not a postcard</span>
        <h2 id="sean-heading" style="font-size: var(--text-h2)">You're not selling to a call center. You're selling to Sean.</h2>
        <p class="mt-4 leading-relaxed text-stone-700">
          Sean Grabow is a Columbus native who started this company in {SITE.founded} after going
          through a stressful home sale of his own. The big national buyers are a phone tree.
          Sean is a guy with an office on East Rich Street who answers his phone, explains every
          number, and moves at your pace — that's been the whole playbook since day one.
        </p>
        <p class="mt-4 leading-relaxed text-stone-700">
          His rules for the team: listen first, explain everything clearly, and never push.
          Read the reviews — Columbus sellers mention Sean, Liam, Noah, and Marie by name,
          because they actually met them.
        </p>
        <a href="/about/" class="btn-secondary mt-6">Meet Sean &amp; the team</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="py-14 sm:py-20" aria-labelledby="reviews-heading">
    <div class="container-site">
      <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <span class="eyebrow">Real Columbus sellers</span>
          <h2 id="reviews-heading" style="font-size: var(--text-h2)">Don't take our word for it.</h2>
        </div>
        <a href="/reviews/" class="font-semibold text-pine-700 underline">Read all the reviews →</a>
      </div>
      <TestimonialCards reviews={FEATURED_REVIEWS.slice(0, 6)} />
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="bg-stone-warm py-14 sm:py-20" aria-labelledby="compare-heading">
    <div class="container-site">
      <div class="reveal mb-8 max-w-2xl">
        <span class="eyebrow">The honest comparison</span>
        <h2 id="compare-heading" style="font-size: var(--text-h2)">Selling to Sean vs. listing with an agent</h2>
        <p class="mt-3 leading-relaxed text-stone-700">
          A cash sale isn't right for everyone — and we'll tell you if it's not right for you.
          Here's the real tradeoff, including the row most buyers hide.
        </p>
      </div>
      <ComparisonTable />
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 sm:py-20" aria-labelledby="faq-heading">
    <div class="container-site">
      <div class="mb-8 text-center">
        <span class="eyebrow">Questions everyone asks</span>
        <h2 id="faq-heading" style="font-size: var(--text-h2)">Good questions. Honest answers. 🤝</h2>
      </div>
      <FAQAccordion faqs={homeFaqs} />
      <p class="mt-6 text-center">
        <a href="/faq/" class="font-semibold text-pine-700 underline">See every question we get →</a>
      </p>
    </div>
  </section>

  <LoudBand heading="Still scrolling? Your offer is one form away." sub="Address, phone, email — that's all Sean needs to get started on your number." />

  <!-- SERVICE AREA / internal links -->
  <section class="border-t border-stone-200 py-10" aria-labelledby="area-heading">
    <div class="container-site">
      <h2 id="area-heading" class="text-lg">Where we buy houses</h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        Sell to Sean buys houses across Columbus and Central Ohio, including
        {CITIES.map((c, i) => (
          <Fragment>
            <a href={`/sell-my-house-fast/${c.slug}/`} class="font-semibold text-pine-700 underline">{c.name}</a>{i < CITIES.length - 1 ? ', ' : ''}
          </Fragment>
        ))}
        and the surrounding communities. Don't see your town? We probably still buy there —
        <a href="/contact/" class="font-semibold text-pine-700 underline">ask us</a>.
      </p>
    </div>
  </section>

  <CTASection formId="home-cta-form" />
</BaseLayout>
