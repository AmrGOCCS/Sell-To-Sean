---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialCards from '../../components/TestimonialCards.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../data/site.js';
import { SITUATIONS } from '../../data/situations.js';
import { CITIES } from '../../data/cities.js';
import { reviewsFor } from '../../data/reviews.js';
import { faqSchema, breadcrumbSchema } from '../../lib/schema.js';

export function getStaticPaths() {
  return SITUATIONS.map((situation) => ({ params: { situation: situation.slug }, props: { situation } }));
}

const { situation } = Astro.props;
const reviews = reviewsFor(situation.reviewPersona, 3);
const others = SITUATIONS.filter((s) => s.slug !== situation.slug);
---

<BaseLayout
  title={situation.metaTitle}
  description={situation.metaDescription}
  schemas={[
    faqSchema(situation.faqs),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: situation.title, path: `/we-buy-houses/${situation.slug}/` },
    ]),
  ]}
>
  <section class="border-b border-stone-200 bg-gradient-to-b from-stone-warm to-cream py-12 sm:py-16">
    <div class="container-site max-w-3xl">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-stone-500">
        <a href="/" class="underline hover:text-pine-700">Home</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{situation.title}</span>
      </nav>
      <h1 style="font-size: var(--text-display)">{situation.h1}</h1>

      <!-- GEO answer-first block: direct, quotable, factual -->
      <p class="mt-5 rounded-2xl border-l-4 border-pine-600 bg-white p-5 text-lg leading-relaxed text-stone-800 shadow-sm">
        {situation.answerFirst}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn-primary">{SITE.cta}</a>
        <a href={SITE.phoneHref} class="btn-secondary" data-track="phone_click" data-loc={`situation_${situation.slug}`}>Call {SITE.phone}</a>
      </div>
      <p class="mt-3 text-sm text-stone-600">Free · Confidential · No obligation</p>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="prose-site container-site max-w-3xl">
      {situation.sections.map((s) => (
        <Fragment>
          <h2>{s.h2}</h2>
          <p>{s.body}</p>
        </Fragment>
      ))}

      <h2>What to do next — three steps</h2>
      <ol>
        {situation.steps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="bg-stone-warm py-14 sm:py-20" aria-label="Relevant reviews">
    <div class="container-site">
      <h2 class="mb-6" style="font-size: var(--text-h2)">{situation.reviewIntro}</h2>
      <TestimonialCards reviews={reviews} />
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-label="Situation FAQ">
    <div class="container-site">
      <h2 class="mb-8 text-center" style="font-size: var(--text-h2)">Your questions, answered straight</h2>
      <FAQAccordion faqs={situation.faqs} />
    </div>
  </section>

  <section class="border-t border-stone-200 py-8" aria-label="Related pages">
    <div class="container-site text-sm text-stone-600">
      Different situation?
      {others.map((s, i) => (
        <Fragment>
          <a href={`/we-buy-houses/${s.slug}/`} class="font-semibold text-pine-700 underline">{s.title.replace(' in Columbus, Ohio', '')}</a>{i < others.length - 1 ? ' · ' : ''}
        </Fragment>
      ))}
      · Or see where we buy: {CITIES.map((c, i) => (
        <Fragment>
          <a href={`/sell-my-house-fast/${c.slug}/`} class="font-semibold text-pine-700 underline">{c.name}</a>{i < CITIES.length - 1 ? ', ' : ''}
        </Fragment>
      ))}
    </div>
  </section>

  <CTASection formId={`situation-${situation.slug}-form`} heading="Start with a number. Decide later." />
</BaseLayout>
