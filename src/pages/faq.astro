---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site.js';
import { FAQS } from '../data/faqs.js';
import { faqSchema, breadcrumbSchema } from '../lib/schema.js';

const title = 'FAQ — Honest Answers About Selling Your House for Cash | Sell to Sean';
const description =
  'Every question Columbus sellers ask us: fees (none), how the offer is calculated, scams, tenants, cleanouts, timelines — answered plainly, including when NOT to sell to us.';
---

<BaseLayout
  title={title}
  description={description}
  schemas={[faqSchema(FAQS), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }])]}
>
  <PageHero eyebrow="No question is too blunt">
    <Fragment slot="title">
      Ask us <span class="inline-block -rotate-1 rounded-xl bg-sun-400 px-2 !text-brand-950">anything</span> 🤝
    </Fragment>
    <p>
      The real questions Columbus sellers ask us — including "is this a scam?" and "would an
      agent get me more?" If yours isn't here, call
      <a href={SITE.phoneHref} data-track="phone_click" data-loc="faq_intro">{SITE.phone}</a>
      and ask a person.
    </p>
  </PageHero>

  <section class="py-14 sm:py-20" aria-label="All questions">
    <div class="container-site">
      <FAQAccordion faqs={FAQS} />
    </div>
  </section>

  <CTASection formId="faq-cta-form" heading="Last question: what's your house worth in cash?" />
</BaseLayout>
