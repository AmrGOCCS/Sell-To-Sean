---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.js';
---

<BaseLayout
  title="Page Not Found | Sell to Sean"
  description="That page doesn't exist — but your cash offer does. Find what you were looking for."
  noindex={true}
>
  <section class="relative overflow-hidden bg-brand-950 py-16 sm:py-24">
    <div aria-hidden="true" class="absolute inset-0">
      <div class="blob animate-blob -top-24 -right-24 h-80 w-80 bg-brand-500 opacity-40"></div>
      <div class="blob animate-blob -bottom-24 -left-16 h-72 w-72 bg-clay-500 opacity-25" style="animation-delay:-6s"></div>
    </div>
    <div class="container-site relative max-w-2xl text-center">
      <p class="inline-block -rotate-2 rounded-2xl bg-sun-400 px-4 font-display text-7xl font-bold text-brand-950 shadow-[6px_6px_0_0_var(--color-clay-600)]" aria-hidden="true">404</p>
      <h1 class="mt-6 !text-white" style="font-size: var(--text-h2)">This page moved out. Your offer didn't.</h1>
      <p class="mt-4 text-lg text-brand-100">
        The page you're looking for isn't here — we recently rebuilt the site. Here's where
        everything lives now:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/get-offer/" class="btn-primary btn-shine">{SITE.cta} <span aria-hidden="true" class="animate-bounce-x">→</span></a>
        <a href="/" class="btn-secondary !border-white !bg-white/10 !text-white hover:!bg-white/20">Go to homepage</a>
      </div>
      <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
        <li><a href="/how-it-works/" class="text-brand-100 underline hover:text-white">How It Works</a></li>
        <li><a href="/about/" class="text-brand-100 underline hover:text-white">About Sean</a></li>
        <li><a href="/reviews/" class="text-brand-100 underline hover:text-white">Reviews</a></li>
        <li><a href="/faq/" class="text-brand-100 underline hover:text-white">FAQ</a></li>
        <li><a href="/contact/" class="text-brand-100 underline hover:text-white">Contact</a></li>
      </ul>
      <p class="mt-8 text-brand-200">
        Or just call us: <a href={SITE.phoneHref} class="font-bold text-white underline" data-track="phone_click" data-loc="404">{SITE.phone}</a>
      </p>
    </div>
  </section>
</BaseLayout>
