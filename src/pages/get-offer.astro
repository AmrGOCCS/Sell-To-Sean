---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE } from '../data/site.js';
import { breadcrumbSchema } from '../lib/schema.js';

const title = 'Get Your Free Cash Offer — Written Within 24 Hours | Sell to Sean';
const description =
  'Tell us about your Columbus house — it takes about 2 minutes. Get a written, no-obligation cash offer within 24 hours. No fees, no repairs, no pressure.';
---

<BaseLayout
  title={title}
  description={description}
  noStickyCta={true}
  schemas={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Get Your Offer', path: '/get-offer/' }])]}
>
  <section class="py-10 sm:py-16">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lg:sticky lg:top-24">
        <span class="eyebrow">Free · written · no obligation</span>
        <h1 style="font-size: var(--text-h2)">Let's find out what your house is worth in cash.</h1>
        <ul class="mt-6 space-y-3 text-stone-700">
          <li class="flex gap-2.5"><span aria-hidden="true" class="font-bold text-pine-600">✓</span> A real person calls you within {SITE.callbackPromise}</li>
          <li class="flex gap-2.5"><span aria-hidden="true" class="font-bold text-pine-600">✓</span> Written offer, usually within 24 hours</li>
          <li class="flex gap-2.5"><span aria-hidden="true" class="font-bold text-pine-600">✓</span> Any condition — repairs and cleanout are our job</li>
          <li class="flex gap-2.5"><span aria-hidden="true" class="font-bold text-pine-600">✓</span> Your info stays with Sean's team. Never sold.</li>
        </ul>
        <blockquote class="card mt-8 !bg-pine-50 text-stone-700">
          "Super easy process, and very easy to work with! They communicated every step of the
          process along the way!"
          <footer class="mt-2 font-bold text-pine-900">— Allison R, Columbus-area seller</footer>
        </blockquote>
        <p class="mt-6 text-sm text-stone-600">
          Rather talk it through? Call
          <a href={SITE.phoneHref} class="font-bold text-pine-800 underline" data-track="phone_click" data-loc="get_offer_page">{SITE.phone}</a>
          — a person answers, not a menu.
        </p>
      </div>
      <LeadForm id="offer-page-form" heading="Get your free cash offer" />
    </div>
  </section>
</BaseLayout>
