---
import { SITE } from '../data/site.js';
import { CITIES } from '../data/cities.js';
import { SITUATIONS } from '../data/situations.js';
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-brand-100">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src="/images/sell-to-sean-logo-white.png" alt="Sell to Sean — A Division of Central City Solutions" width="146" height="60" loading="lazy" class="h-14 w-auto" />
      <p class="mt-4 text-sm leading-relaxed">
        {SITE.legalName}, doing business as Sell to Sean, is a local cash home buyer in Columbus,
        Ohio — buying houses in any condition across Central Ohio since {SITE.founded}.
      </p>
      <p class="mt-4 text-sm">
        <span class="block font-semibold text-white">{SITE.address.street}</span>
        {SITE.address.city}, {SITE.address.state} {SITE.address.zip}
      </p>
      <a href={SITE.phoneHref} class="mt-2 inline-block text-base font-bold text-white underline" data-track="phone_click" data-loc="footer">
        {SITE.phone}
      </a>
    </div>

    <nav aria-label="Footer — company">
      <p class="mb-3 text-sm font-bold tracking-widest text-brand-300 uppercase">Company</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/how-it-works/" class="hover:text-white hover:underline">How It Works</a></li>
        <li><a href="/about/" class="hover:text-white hover:underline">About Sean</a></li>
        <li><a href="/reviews/" class="hover:text-white hover:underline">Reviews</a></li>
        <li><a href="/before-after/" class="hover:text-white hover:underline">Before &amp; After</a></li>
        <li><a href="/faq/" class="hover:text-white hover:underline">FAQ</a></li>
        <li><a href="/contact/" class="hover:text-white hover:underline">Contact</a></li>
      </ul>
    </nav>

    <nav aria-label="Footer — situations">
      <p class="mb-3 text-sm font-bold tracking-widest text-brand-300 uppercase">We Can Help With</p>
      <ul class="space-y-2.5 text-sm">
        {SITUATIONS.map((s) => (
          <li><a href={`/we-buy-houses/${s.slug}/`} class="hover:text-white hover:underline">{s.title.replace(' in Columbus, Ohio', '')}</a></li>
        ))}
      </ul>
      <p class="mt-5 mb-3 text-sm font-bold tracking-widest text-brand-300 uppercase">Where We Buy</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="hover:text-white hover:underline">Columbus</a></li>
        {CITIES.map((c) => (
          <li><a href={`/sell-my-house-fast/${c.slug}/`} class="hover:text-white hover:underline">{c.name}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="mb-3 text-sm font-bold tracking-widest text-brand-300 uppercase">Get Started</p>
      <a href="/get-offer/" class="btn-primary w-full">{SITE.cta}</a>
      <p class="mt-3 text-xs text-brand-300">Free. No obligation. Takes about 2 minutes.</p>
      <ul class="mt-6 flex gap-4 text-sm">
        <li><a href={SITE.social.googleMaps} rel="noopener" target="_blank" class="underline hover:text-white">Google</a></li>
        <li><a href={SITE.social.yelp} rel="noopener" target="_blank" class="underline hover:text-white">Yelp</a></li>
        <li><a href={SITE.social.linkedin} rel="noopener" target="_blank" class="underline hover:text-white">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-900">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-brand-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName} d/b/a Sell to Sean. All rights reserved.</p>
      <p class="flex gap-4">
        <a href="/privacy/" class="hover:text-white hover:underline">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white hover:underline">Terms of Use</a>
      </p>
    </div>
  </div>
</footer>

<!-- Lightweight event tracking: phone clicks + 75% scroll depth → dataLayer -->
<script>
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-track]');
    if (el) {
      (window as any).dataLayer.push({
        event: el.getAttribute('data-track'),
        location: el.getAttribute('data-loc') || 'unknown',
        page: location.pathname,
      });
    }
  });
  let fired = false;
  addEventListener(
    'scroll',
    () => {
      if (fired) return;
      const d = document.documentElement;
      if ((scrollY + innerHeight) / d.scrollHeight >= 0.75) {
        fired = true;
        (window as any).dataLayer.push({ event: 'scroll_75', page: location.pathname });
      }
    },
    { passive: true }
  );
</script>
